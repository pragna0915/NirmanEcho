# Copy this file to .env, then fill in credentials locally. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# Set a long random value. Meta uses this for webhook verification.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v27.0

# Public HTTPS URL for Meta callbacks after deployment, for example:
# https://api.example.com/api/webhooks/whatsapp
PUBLIC_BASE_URL=http://localhost:8000
MAX_AUDIO_MB=20
